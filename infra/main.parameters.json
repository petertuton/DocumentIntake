{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "foundryLocation": {
      "value": "${AZURE_FOUNDRY_LOCATION=westus}"
    },
    "mailboxFolder": {
      "value": "${MAILBOX_FOLDER=Inbox}"
    },
    "dataverseEnvironmentUrl": {
      "value": "${DATAVERSE_ENVIRONMENT_URL=}"
    },
    "dataverseEntitySetName": {
      "value": "${DATAVERSE_ENTITY_SET_NAME=}"
    },
    "dataverseEnabled": {
      "value": "${DATAVERSE_ENABLED=false}"
    }
  }
}
