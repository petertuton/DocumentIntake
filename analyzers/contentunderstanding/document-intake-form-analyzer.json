{
  "description": "Extracts Virginia DMAS HIPP application fields from classified documents using OCR, layout analysis, and source confidence.",
  "baseAnalyzerId": "prebuilt-document",
  "tags": {
    "project": "document-intake"
  },
  "config": {
    "returnDetails": true,
    "enableOcr": true,
    "enableLayout": true,
    "estimateFieldSourceAndConfidence": true
  },
  "fieldSchema": {
    "name": "HippApplication",
    "description": "Fields captured from a Virginia DMAS HIPP application or HIPP correspondence form.",
    "fields": {
      "ApplicationId": {
        "type": "string",
        "method": "extract",
        "description": "The HIPP application identifier, usually printed near the form heading."
      },
      "CorrespondenceType": {
        "type": "string",
        "method": "extract",
        "description": "The selected HIPP correspondence type: New HIPP application, Quarterly Paystub Submission, Annual HIPP Renewal, or Information change."
      },
      "HippNumber": {
        "type": "string",
        "method": "extract",
        "description": "The five-digit HIPP number, when present."
      },
      "PolicyholderFirstName": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder or employee first name."
      },
      "PolicyholderMiddleInitial": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder or employee middle initial."
      },
      "PolicyholderLastName": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder or employee last name."
      },
      "PolicyholderDateOfBirth": {
        "type": "date",
        "method": "extract",
        "description": "Policyholder or employee date of birth."
      },
      "PolicyholderGetsMedicaid": {
        "type": "boolean",
        "method": "extract",
        "description": "Whether the policyholder receives Medicaid."
      },
      "PolicyholderMedicaidId": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder Medicaid identification number."
      },
      "PolicyholderGetsMedicare": {
        "type": "boolean",
        "method": "extract",
        "description": "Whether the policyholder receives Medicare."
      },
      "PolicyholderHomePhoneNumber": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder home telephone number."
      },
      "PolicyholderCellNumber": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder cell telephone number."
      },
      "PolicyholderStreetAddress": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder street address."
      },
      "PolicyholderCity": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder city."
      },
      "PolicyholderState": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder state abbreviation."
      },
      "PolicyholderZipCode": {
        "type": "string",
        "method": "extract",
        "description": "Policyholder ZIP code."
      },
      "EmployeeStatus": {
        "type": "string",
        "method": "extract",
        "description": "Employment status shown in the HIPP employment section."
      },
      "EmployerCompanyName": {
        "type": "string",
        "method": "extract",
        "description": "Employer company name."
      },
      "EmployerSubscriberInsurancePolicyNumber": {
        "type": "string",
        "method": "extract",
        "description": "Employer subscriber insurance policy number."
      },
      "InsurancePlanType": {
        "type": "string",
        "method": "extract",
        "description": "Insurance plan type."
      },
      "InsuranceEffectiveDate": {
        "type": "date",
        "method": "extract",
        "description": "Effective date of the employer insurance coverage."
      },
      "MedicalCarrierName": {
        "type": "string",
        "method": "extract",
        "description": "Medical insurance company name."
      },
      "MedicalGroupNumber": {
        "type": "string",
        "method": "extract",
        "description": "Medical insurance group number."
      },
      "MedicalPolicyNumber": {
        "type": "string",
        "method": "extract",
        "description": "Medical insurance policy number."
      },
      "AgreementTrueAccurateInformation": {
        "type": "boolean",
        "method": "extract",
        "description": "Whether the applicant agreed that the information is true and accurate."
      },
      "AgreementFormStatusComplete": {
        "type": "boolean",
        "method": "extract",
        "description": "Whether the HIPP application form is marked complete."
      }
    }
  }
}
